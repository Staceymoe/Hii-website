{
  "name": "hii-website",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/verify-front-door.mjs --source-only && node scripts/stage-front-door.mjs && eleventy",
    "serve": "node scripts/verify-front-door.mjs --source-only && node scripts/stage-front-door.mjs && eleventy --serve",
    "verify:front-door": "node scripts/verify-front-door.mjs",
    "check:site": "node scripts/check-built-site.mjs",
    "test": "pnpm verify:front-door && pnpm check:site"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6"
  }
}
