{% set workshop = library.programs.introductoryWorkshop %}
{% set advisory = library.programs.advisorySession %}

<style>
  .adapt-hero h1 { max-width: 10ch; }
  .adapt-speed-section {
    padding-block: clamp(5rem, 10vw, 9rem);
    border-top: 1px solid var(--line);
  }
  .adapt-speed-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(20rem, 1.22fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 6rem);
  }
  .adapt-speed-intro h2 { max-width: 13ch; margin-bottom: 0; }
  .adapt-speed-intro > p { max-width: 42rem; margin: 0; color: var(--ivory-soft); }
  .adapt-speed-visual {
    position: relative;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    background: radial-gradient(circle at center, rgba(203,184,142,0.08), transparent 36%);
  }
  .adapt-speed-stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(30rem, 62vw, 47rem);
  }
  .adapt-speed-core {
    position: relative;
    z-index: 3;
    display: grid;
    place-items: center;
    width: clamp(9rem, 18vw, 14rem);
    aspect-ratio: 1;
    padding: 1.5rem;
    color: var(--ink);
    background: var(--ivory);
    border-radius: 50%;
    font-size: clamp(1rem, 1.8vw, 1.35rem);
    font-weight: 500;
    text-align: center;
  }
  .adapt-orbit {
    position: absolute;
    z-index: 1;
    border: 1px solid rgba(242,237,226,0.2);
    border-radius: 50%;
  }
  .adapt-orbit::before {
    content: "";
    position: absolute;
    top: 50%;
    left: -0.32rem;
    width: 0.64rem;
    aspect-ratio: 1;
    background: var(--champagne);
    border-radius: 50%;
    box-shadow: 0 0 1.5rem rgba(203,184,142,0.7);
  }
  .adapt-orbit span {
    position: absolute;
    top: -0.85rem;
    left: 50%;
    padding: 0.25rem 0.65rem;
    color: var(--muted);
    background: var(--ink);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transform: translateX(-50%);
  }
  .adapt-orbit-one {
    width: clamp(16rem, 31vw, 25rem);
    aspect-ratio: 1;
    animation: adapt-orbit 8s linear infinite;
  }
  .adapt-orbit-one span { animation: adapt-label-reverse 8s linear infinite; }
  .adapt-orbit-two {
    width: clamp(22rem, 43vw, 34rem);
    aspect-ratio: 1;
    animation: adapt-orbit 14s linear infinite reverse;
  }
  .adapt-orbit-two span { animation: adapt-label-forward 14s linear infinite; }
  .adapt-orbit-three {
    width: clamp(28rem, 55vw, 43rem);
    aspect-ratio: 1;
    animation: adapt-orbit 22s linear infinite;
  }
  .adapt-orbit-three span { animation: adapt-label-reverse 22s linear infinite; }
  .adapt-orbit-four {
    width: clamp(34rem, 67vw, 52rem);
    aspect-ratio: 1;
    animation: adapt-orbit 32s linear infinite reverse;
  }
  .adapt-orbit-four span { animation: adapt-label-forward 32s linear infinite; }
  .adapt-speed-visual figcaption {
    position: relative;
    z-index: 4;
    margin: 0;
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.76rem;
    text-align: center;
  }
  .adapt-speed-legend {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  @keyframes adapt-orbit { to { transform: rotate(360deg); } }
  @keyframes adapt-label-reverse {
    to { transform: translateX(-50%) rotate(-360deg); }
  }
  @keyframes adapt-label-forward {
    to { transform: translateX(-50%) rotate(360deg); }
  }
  .adapt-layers { padding-block: clamp(5rem, 10vw, 9rem); }
  .adapt-layer-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(3rem, 6vw, 5rem);
    background: var(--line);
    border: 1px solid var(--line);
  }
  .adapt-layer-card {
    grid-column: span 2;
    min-height: 24rem;
    padding: clamp(1.6rem, 3vw, 2.6rem);
    background: var(--ink);
  }
  .adapt-layer-card:nth-last-child(-n + 2) { grid-column: span 3; }
  .adapt-layer-card h3 { max-width: 13ch; margin: 2.5rem 0 1.5rem; }
  .adapt-layer-card > p:last-child { color: var(--ivory-soft); }
  .adapt-boundary-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(20rem, 1.2fr);
    gap: clamp(3rem, 8vw, 8rem);
    padding-block: clamp(6rem, 12vw, 11rem);
    align-items: start;
  }
  .adapt-boundary-grid .eyebrow { color: #6c5d3e; }
  .adapt-boundary-grid h2 { max-width: 14ch; }
  .adapt-boundary-copy { max-width: 43rem; }
  .adapt-boundary-copy p { color: #4f4b44; }
  .adapt-preserve { padding-block: clamp(5rem, 10vw, 9rem); }
  .adapt-preserve-list { margin-top: clamp(3rem, 6vw, 5rem); border-top: 1px solid var(--line); }
  .adapt-preserve-row {
    display: grid;
    grid-template-columns: 4rem minmax(14rem, 0.65fr) minmax(0, 1.35fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    padding-block: clamp(1.8rem, 4vw, 3rem);
    border-bottom: 1px solid var(--line);
    align-items: start;
  }
  .adapt-preserve-row span { color: var(--champagne); font-size: 0.72rem; }
  .adapt-preserve-row h3 { margin: 0; }
  .adapt-preserve-row p { margin: 0; color: var(--muted); }
  .adapt-patterns { padding-block: clamp(5rem, 10vw, 9rem); }
  .adapt-patterns .eyebrow { color: #6c5d3e; }
  .adapt-patterns .section-heading > p:not(.eyebrow) { color: #5f5a51; }
  .adapt-pattern-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(3rem, 6vw, 5rem);
    background: rgba(8,11,16,0.18);
    border: 1px solid rgba(8,11,16,0.18);
  }
  .adapt-pattern {
    min-height: 16rem;
    padding: clamp(1.8rem, 3vw, 2.7rem);
    color: var(--ink);
    background: var(--ivory);
  }
  .adapt-pattern p { color: #5f5a51; }
  .adapt-offers { padding-block: clamp(5rem, 10vw, 9rem); }
  .adapt-offer-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(3rem, 6vw, 5rem);
    background: var(--line);
    border: 1px solid var(--line);
  }
  .adapt-offer-card {
    display: flex;
    flex-direction: column;
    min-height: 24rem;
    padding: clamp(1.8rem, 3.5vw, 3rem);
    background: var(--ink);
  }
  .adapt-offer-card h3 { max-width: 15ch; }
  .adapt-offer-card p { color: var(--ivory-soft); }
  .adapt-offer-card .text-link { margin-top: auto; }
  @media (prefers-reduced-motion: reduce) {
    .adapt-orbit,
    .adapt-orbit span { animation: none; }
  }
  @media (max-width: 900px) {
    .adapt-layer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .adapt-layer-card,
    .adapt-layer-card:nth-last-child(-n + 2) { grid-column: span 1; }
    .adapt-layer-card:last-child { grid-column: 1 / -1; }
  }
  @media (max-width: 760px) {
    .adapt-speed-intro,
    .adapt-boundary-grid { grid-template-columns: 1fr; }
    .adapt-speed-stage { min-height: min(92vw, 22rem); }
    .adapt-speed-core {
      width: min(29vw, 7rem);
      padding: 1rem;
      font-size: 1rem;
    }
    .adapt-orbit-four { width: min(78vw, 19rem); }
    .adapt-orbit-three { width: min(64vw, 15.5rem); }
    .adapt-orbit-two { width: min(50vw, 12rem); }
    .adapt-orbit-one { width: min(38vw, 9rem); }
    .adapt-orbit span { display: none; }
    .adapt-speed-legend {
      position: static;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: auto;
      height: auto;
      margin: 0;
      padding: 1rem 1.25rem;
      overflow: visible;
      clip-path: none;
      white-space: normal;
      border-top: 1px solid var(--line);
      list-style: none;
    }
    .adapt-speed-legend li {
      position: relative;
      margin: 0;
      padding: 0.45rem 0.5rem 0.45rem 1rem;
      color: var(--muted);
      font-size: 0.64rem;
      letter-spacing: 0.1em;
      line-height: 1.4;
      text-transform: uppercase;
    }
    .adapt-speed-legend li::before {
      content: "";
      position: absolute;
      top: 0.82rem;
      left: 0;
      width: 0.38rem;
      aspect-ratio: 1;
      background: var(--champagne);
      border-radius: 50%;
    }
    .adapt-speed-visual figcaption { padding-block: 0.9rem; }
    .adapt-layer-grid,
    .adapt-pattern-grid,
    .adapt-offer-grid { grid-template-columns: 1fr; }
    .adapt-layer-card,
    .adapt-layer-card:nth-last-child(-n + 2),
    .adapt-layer-card:last-child { grid-column: auto; min-height: auto; }
    .adapt-preserve-row { grid-template-columns: 2.5rem 1fr; }
    .adapt-preserve-row p { grid-column: 2; }
  }
</style>

<section class="world-hero section-shell adapt-hero">
  <div class="world-hero-copy">
    <p class="eyebrow">Adapt</p>
    <h1>You do not have to speed up to match the world.</h1>
    <p class="lede">Hii studies how people and institutions adapt as AI changes work, learning, judgment, identity, relationships, and public life.</p>
  </div>
  <blockquote>How do people remain capable and oriented while the surrounding system changes faster than shared norms?</blockquote>
</section>

<section class="section-shell adapt-speed-section" aria-labelledby="adapt-speed-heading">
  <div class="adapt-speed-intro">
    <div>
      <p class="eyebrow">Concept visualization</p>
      <h2 id="adapt-speed-heading">Change does not arrive at one speed.</h2>
    </div>
    <p>AI systems, institutions, norms, and human lives move on different timelines. Adaptation becomes difficult when people are expected to absorb the mismatch alone.</p>
  </div>
  <figure class="adapt-speed-visual">
    <div class="adapt-speed-stage">
      <div class="adapt-speed-core">A human pace</div>
      <div class="adapt-orbit adapt-orbit-one"><span>AI systems</span></div>
      <div class="adapt-orbit adapt-orbit-two"><span>Work and learning</span></div>
      <div class="adapt-orbit adapt-orbit-three"><span>Institutions</span></div>
      <div class="adapt-orbit adapt-orbit-four"><span>Shared norms</span></div>
    </div>
    <ul class="adapt-speed-legend" aria-label="Systems moving at different speeds">
      <li>AI systems</li>
      <li>Work and learning</li>
      <li>Institutions</li>
      <li>Shared norms</li>
    </ul>
    <figcaption>Concept visualization. Orbit speed represents difference in pace, not a measured rate of change.</figcaption>
  </figure>
</section>

<section class="section-shell adapt-layers" aria-labelledby="adapt-layers-heading">
  <div class="section-heading compact-heading">
    <p class="eyebrow">The whole human system</p>
    <h2 id="adapt-layers-heading">Adaptation reaches beyond learning a tool.</h2>
    <p>It can change how people understand themselves, what they practice, where they turn for support, and what institutions expect from them.</p>
  </div>
  <div class="adapt-layer-grid">
    <article class="adapt-layer-card">
      <p class="pathway-number">Psychological</p>
      <h3>Meaning, confidence, and uncertainty</h3>
      <p>How people respond to acceleration, comparison, replacement fears, expanded capability, and rapidly changing expectations.</p>
    </article>
    <article class="adapt-layer-card">
      <p class="pathway-number">Cognitive</p>
      <h3>Thinking with AI</h3>
      <p>How memory, attention, problem-solving, authorship, learning, and judgment change when cognitive work is distributed across systems.</p>
    </article>
    <article class="adapt-layer-card">
      <p class="pathway-number">Relational</p>
      <h3>Effects beyond the interface</h3>
      <p>How AI use affects family life, intimacy, collaboration, social trust, conflict, and the balance between machine and human support.</p>
    </article>
    <article class="adapt-layer-card">
      <p class="pathway-number">Economic</p>
      <h3>Work, livelihood, and uneven pressure</h3>
      <p>How changing roles, expectations, access, and bargaining power shape who gains capacity, who carries risk, and who is asked to adapt fastest.</p>
    </article>
    <article class="adapt-layer-card">
      <p class="pathway-number">Institutional</p>
      <h3>Systems adapting unevenly</h3>
      <p>How schools, healthcare, workplaces, government, and civil society respond at different speeds and with different levels of preparation.</p>
    </article>
  </div>
</section>

<section class="boundary-section">
  <div class="section-shell adapt-boundary-grid">
    <div>
      <p class="eyebrow">A necessary boundary</p>
      <h2>Adaptation is not the same as acceptance.</h2>
    </div>
    <div class="adapt-boundary-copy">
      <p>Hii does not assume every technological change is desirable or inevitable.</p>
      <p>The question is not only how humans can adjust. It is which conditions expand human capability, which create harm or exclusion, and where people and institutions should slow, redesign, or refuse.</p>
    </div>
  </div>
</section>

<section class="section-shell adapt-preserve" aria-labelledby="adapt-preserve-heading">
  <div class="section-heading compact-heading">
    <p class="eyebrow">What adaptation should preserve</p>
    <h2 id="adapt-preserve-heading">Protect what speed can quietly erode.</h2>
  </div>
  <div class="adapt-preserve-list">
    <article class="adapt-preserve-row"><span>01</span><h3>Agency</h3><p>The ability to choose, question, refuse, and act without quietly surrendering direction to a system.</p></article>
    <article class="adapt-preserve-row"><span>02</span><h3>Judgment</h3><p>The continued practice of evaluating evidence, consequences, uncertainty, and competing interpretations.</p></article>
    <article class="adapt-preserve-row"><span>03</span><h3>Coherence</h3><p>A usable sense of context, history, identity, and what connects one decision or change to another.</p></article>
    <article class="adapt-preserve-row"><span>04</span><h3>Meaning</h3><p>Room for human purpose, authorship, values, grief, creativity, and experience that cannot be reduced to efficiency.</p></article>
    <article class="adapt-preserve-row"><span>05</span><h3>Relational health</h3><p>Connections that support reciprocity, accountability, belonging, disagreement, repair, and care across human and AI-mediated life.</p></article>
  </div>
</section>

<section class="boundary-section">
  <div class="section-shell adapt-patterns" aria-labelledby="adapt-patterns-heading">
    <div class="section-heading compact-heading">
      <p class="eyebrow">Notice the direction</p>
      <h2 id="adapt-patterns-heading">Useful adaptation should increase human capacity.</h2>
      <p>These are not simple binaries or universal verdicts. They are practical patterns to notice over time.</p>
    </div>
    <div class="adapt-pattern-grid">
      <article class="adapt-pattern"><h3>Capacity or substitution?</h3><p>Is the system helping a person practice and extend judgment, or replacing practices they may later need?</p></article>
      <article class="adapt-pattern"><h3>Connection or isolation?</h3><p>Does use support participation in human life, or gradually become the only place a person feels understood or able to act?</p></article>
      <article class="adapt-pattern"><h3>Orientation or overload?</h3><p>Does interaction help someone see context and choose a next step, or create more inputs, urgency, and unresolved loops?</p></article>
      <article class="adapt-pattern"><h3>Support or dependence?</h3><p>Can the person pause, disagree, verify, and function when the system changes or is unavailable?</p></article>
    </div>
  </div>
</section>

<section class="section-shell adapt-offers" aria-labelledby="adapt-offers-heading">
  <div class="section-heading compact-heading">
    <p class="eyebrow">Bring the question into practice</p>
    <h2 id="adapt-offers-heading">Help your organization adapt around the technology.</h2>
    <p>Hii offers bounded, founder-led engagements for teams that need language, orientation, and a practical place to begin.</p>
  </div>
  <div class="adapt-offer-grid">
    <article class="adapt-offer-card">
      <p class="pathway-number">{{ workshop.status.display }}</p>
      <h3>{{ workshop.title }}</h3>
      <p>{{ workshop.format }}</p>
      <p>{{ workshop.summary }}</p>
      <a class="text-link" href="/relationships/research-inquiry/?topic=workshop">Ask about a workshop <span aria-hidden="true">↗</span></a>
    </article>
    <article class="adapt-offer-card">
      <p class="pathway-number">{{ advisory.status.display }}</p>
      <h3>{{ advisory.title }}</h3>
      <p>{{ advisory.format }}</p>
      <p>{{ advisory.summary }}</p>
      <a class="text-link" href="/relationships/research-inquiry/?topic=advisory">Ask about an advisory session <span aria-hidden="true">↗</span></a>
    </article>
  </div>
</section>

<section class="research-inquiry-section">
  <div class="section-shell research-inquiry-inner">
    <div>
      <p class="eyebrow">The Hii bridge</p>
      <h2>Human adaptation should not be left to individuals to solve alone.</h2>
    </div>
    <div>
      <p>Hii connects research, lived experience, clinical practice, public understanding, and institutional response so the burden of adaptation can become visible and shared.</p>
      <a class="button-link" href="/relationships/research-inquiry/?topic=adaptation">Talk with Hii</a>
    </div>
  </div>
</section>

<section class="section-shell closing-section" aria-labelledby="adapt-closing-heading">
  <p class="eyebrow">Continue</p>
  <h2 id="adapt-closing-heading">Choose the part of the transition you need to see more clearly.</h2>
