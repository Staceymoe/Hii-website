---
layout: layouts/world.njk
title: Hii Inquiry
description: Contact Hii about research collaboration, education or training, speaking or media, partnership or funding, and papers or resources.
permalink: /relationships/research-inquiry/index.html
robots: noindex
pageScript: /assets/js/inquiry.js
---
{% set inquiry = library.inquiries.research %}

<article class="inquiry-page">
  <header class="section-shell internal-page-hero inquiry-page-hero">
    <a class="back-link" href="/?return=hii">← Back to Hii</a>
    <p class="eyebrow">Inquiry</p>
    <h1>What would you like to explore?</h1>
    <p class="lede">Use one form for research, CARE, workshops, advisory work, speaking, media, partnerships, and general organizational inquiries.</p>
  </header>

  <section class="section-shell inquiry-form-section" aria-labelledby="inquiry-form-heading">
    <div class="inquiry-form-heading">
      <p class="eyebrow">Inquiry form</p>
      <h2 id="inquiry-form-heading">What would you like to explore?</h2>
      <p>This form is for research and organizational inquiries, not clinical support. Do not submit confidential, patient-identifying, crisis, or emergency information.</p>
    </div>

    <form class="research-inquiry-form" name="hii-inquiry" method="post" data-netlify="true" netlify-honeypot="company-website" action="/relationships/research-inquiry/thanks/">
      <input type="hidden" name="form-name" value="hii-inquiry">
      <p class="form-honeypot" aria-hidden="true"><label>Leave this field empty <input name="company-website" tabindex="-1" autocomplete="off"></label></p>
      <fieldset>
        <legend>Inquiry details</legend>
        <div class="form-grid">
          <label><span>Full name <strong aria-hidden="true">*</strong></span><input type="text" name="full-name" autocomplete="name" required></label>
          <label><span>Email address <strong aria-hidden="true">*</strong></span><input type="email" name="email" autocomplete="email" required></label>
          <label><span>Role or title <strong aria-hidden="true">*</strong></span><input type="text" name="role" autocomplete="organization-title" placeholder="Independent is welcome" required></label>
          <label><span>Organization or affiliation</span><input type="text" name="organization" autocomplete="organization"></label>
          <label><span>Phone number</span><input type="tel" name="phone" autocomplete="tel"></label>
          <label><span>Website or LinkedIn profile</span><input type="url" name="website" autocomplete="url"></label>
          <label class="form-field-wide"><span>Area of interest <strong aria-hidden="true">*</strong></span><select id="inquiry-topic" name="area-of-interest" required><option value="">Select one</option><option value="research">Research collaboration</option><option value="care">CARE or clinician education</option><option value="workshop">Workshop or briefing</option><option value="advisory">Advisory or strategy session</option><option value="adaptation">Human adaptation</option><option value="speaking-media">Speaking or media</option><option value="partnership-funding">Partnership or funding</option><option value="paper-resource">Paper or resource inquiry</option><option value="public-session">Future public learning session</option><option value="work-with-hii">Work with Hii</option><option value="general">General inquiry</option></select></label>
          <label class="form-field-wide"><span>What would you like to explore? <strong aria-hidden="true">*</strong></span><textarea name="message" rows="6" required></textarea></label>
        </div>
        <label class="consent-field"><input type="checkbox" name="consent" required><span>I consent to Hii using this information to respond to my inquiry. Read the <a href="{{ inquiry.privacyHref }}" target="_blank" rel="noopener">inquiry privacy notice</a>.</span></label>
        <button class="button-link form-submit" type="submit">Submit inquiry</button>
      </fieldset>
    </form>
  </section>

  <footer class="section-shell internal-page-return">
    <a class="back-link" href="/?return=hii">← Back to Hii</a>
  </footer>
</article>
