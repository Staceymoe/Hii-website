<footer class="site-footer">
  <div>
    <p class="footer-name">{{ site.expandedName }}</p>
    <p>{{ site.description }}</p>
  </div>
  <div>
    <p>{{ site.tagline }}</p>
    <p class="muted">{{ site.pronunciation }}</p>
  </div>
  <nav aria-label="Footer navigation">
    <ul>
      {% for link in site.utilityLinks %}
        <li><a href="{{ link.href }}">{{ link.label }}</a></li>
      {% endfor %}
    </ul>
  </nav>
</footer>
