<figure class="relationship-map" aria-labelledby="relationship-map-title relationship-map-caption">
  <svg class="relationship-system-svg" viewBox="0 0 720 620" role="img" aria-labelledby="relationship-map-title relationship-map-description">
    <title id="relationship-map-title">The relationship as a five-part system</title>
    <desc id="relationship-map-description">Human Context, AI System, Social World, and Time each point inward to Relationship at the center.</desc>
    <defs>
      <marker id="relationship-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" class="system-arrowhead"></path>
      </marker>
    </defs>
    <g class="system-connections" aria-hidden="true">
      <path class="system-line" d="M 210 175 L 300 255" marker-end="url(#relationship-arrow)"></path>
      <path class="system-line" d="M 510 175 L 420 255" marker-end="url(#relationship-arrow)"></path>
      <path class="system-line" d="M 210 445 L 300 365" marker-end="url(#relationship-arrow)"></path>
      <path class="system-line" d="M 510 445 L 420 365" marker-end="url(#relationship-arrow)"></path>
      <path class="system-flow system-flow-one" d="M 210 175 L 300 255"></path>
      <path class="system-flow system-flow-two" d="M 510 175 L 420 255"></path>
      <path class="system-flow system-flow-three" d="M 210 445 L 300 365"></path>
      <path class="system-flow system-flow-four" d="M 510 445 L 420 365"></path>
    </g>
    <g class="system-center" aria-hidden="true">
      <circle class="system-trace system-trace-outer" cx="360" cy="310" r="126"></circle>
      <circle class="system-trace system-trace-inner" cx="360" cy="310" r="112"></circle>
      <circle class="system-center-ring" cx="360" cy="310" r="98"></circle>
      <text x="360" y="318" text-anchor="middle">Relationship</text>
    </g>
    <g class="system-node" transform="translate(135 105)" aria-hidden="true"><circle r="82"></circle><text text-anchor="middle"><tspan x="0" y="-5">Human</tspan><tspan x="0" y="22">Context</tspan></text></g>
    <g class="system-node" transform="translate(585 105)" aria-hidden="true"><circle r="82"></circle><text text-anchor="middle"><tspan x="0" y="-5">AI</tspan><tspan x="0" y="22">System</tspan></text></g>
    <g class="system-node" transform="translate(135 515)" aria-hidden="true"><circle r="82"></circle><text text-anchor="middle"><tspan x="0" y="-5">Social</tspan><tspan x="0" y="22">World</tspan></text></g>
    <g class="system-node" transform="translate(585 515)" aria-hidden="true"><circle r="82"></circle><text y="8" text-anchor="middle">Time</text></g>
  </svg>
  <figcaption id="relationship-map-caption">Human context, the AI system, the social world, and time continually shape the relationship.</figcaption>
</figure>
