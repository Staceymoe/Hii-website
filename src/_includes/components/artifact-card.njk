<article class="artifact-card">
  <p class="artifact-type">{{ artifact.type | replace('-', ' ') }}</p>
  <h3>{{ artifact.title }}</h3>
  <p class="artifact-status">{{ artifact.status }}</p>
  <p>{{ artifact.summary }}</p>
  <a class="text-link" href="{{ artifact.href }}">Read the current artifact <span aria-hidden="true">↗</span></a>
</article>
